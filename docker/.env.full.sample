# cp .env.full.sample .env.full lalu isi. .env.full digitignore.
# Redirect URL OAuth tetap localhost:5173 — registrasi dev dipakai ulang.
OTP_SECRET=
JWT_SECRET=

# Email. smtp (bawaan) memakai blok SMTP_*; resend memakai RESEND_API_KEY.
# MAIL_FROM dipakai keduanya; SMTP_FROM lama masih diterima sebagai fallback.
# MAIL_REPLY_TO opsional; kosong = balasan ke MAIL_FROM.
MAIL_PROVIDER=smtp
MAIL_FROM=Rakda <no-reply@localhost>
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# mandatory (bawaan) | opportunistic | none. none untuk Mailpit/MailHog lokal.
SMTP_TLS=mandatory
RESEND_API_KEY=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://localhost:5173/auth/sso/github/callback

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:5173/auth/sso/google/callback
