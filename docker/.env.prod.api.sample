# cp .env.prod.api.sample .env.prod.api lalu isi. File nyata digitignore.

ADDR=:8080

# Managed PostgreSQL provider (PG 16).
# Role migrasi harus boleh CREATE EXTENSION pg_trgm (cek whitelist provider).
# WAJIB direct connection atau session pooler — transaction pooler merusak
# prepared statement pgx (SQLSTATE 26000). Salin host/port/user PERSIS dari
# panel (ekor username = tenant id, jangan dibuang).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=rakda
DB_SSLMODE=require
# Default kode 25/25, dan idle jadi MinConns pgx (eager) — melampaui limit
# koneksi plan managed kecil. Naikkan hanya setelah cek limit plan.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=10m

# Object storage S3-compatible. Endpoint TANPA scheme (host[:port]).
# Bucket dibuat manual di console provider — kredensial S3 umumnya tanpa
# izin CreateBucket, dan boot hanya membuat bila belum ada.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rakda-file
MINIO_SSL_MODE=true

# goose (docker compose -f compose.prod.yaml run --rm migrate up).
# Harus selaras dengan blok DB_* di atas.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://USER:PASSWORD@HOST:5432/rakda?sslmode=require

OTP_SECRET=
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=https://DOMAIN/auth/sso/github/callback

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://DOMAIN/auth/sso/google/callback

GOTENBERG_URL=http://172.29.0.13:3000
WEB_URL=https://DOMAIN

# Hanya traefik (.10) dan web (.11) di subnet compose prod 172.29.0.0/24 —
# bukan seluruh subnet. Kosong = XFF tidak pernah dipercaya.
TRUSTED_PROXY_CIDRS=172.29.0.10/32,172.29.0.11/32
