# cp .env.prod.api.sample .env.prod.api lalu isi. File nyata digitignore.

ADDR=:8080

# Managed PostgreSQL provider (PG 16).
# Role migrasi harus boleh CREATE EXTENSION pg_trgm (cek whitelist provider).
# WAJIB direct connection atau session pooler — transaction pooler merusak
# prepared statement pgx (SQLSTATE 26000). Salin host/port/user PERSIS dari
# panel (ekor username = tenant id, jangan dibuang).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=rakda
DB_SSLMODE=require
# Default kode 25/25, dan idle jadi MinConns pgx (eager) — melampaui limit
# koneksi plan managed kecil. Naikkan hanya setelah cek limit plan.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=10m

# Object storage S3-compatible. Endpoint TANPA scheme (host[:port]).
# Bucket dibuat manual di console provider — kredensial S3 umumnya tanpa
# izin CreateBucket, dan boot hanya membuat bila belum ada.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rakda-file
MINIO_SSL_MODE=true

# Enkripsi at-rest. true = API menolak boot bila bucket tidak terbukti
# terenkripsi — termasuk bila statusnya tidak bisa dibaca, karena klaim keamanan
# yang tak bisa dibuktikan tidak boleh lolos. Aktifkan enkripsi bucket-default
# (SSE-S3/AES256) di console provider lebih dulu; kredensial aplikasi umumnya
# tidak berizin menyetelnya sendiri, sama seperti pembuatan bucket di atas.
# Menuntut MINIO_SSL_MODE=true.
MINIO_REQUIRE_ENCRYPTION=true

# goose (docker compose -f compose.prod.yaml run --rm migrate up).
# Harus selaras dengan blok DB_* di atas.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://USER:PASSWORD@HOST:5432/rakda?sslmode=require

OTP_SECRET=
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=https://DOMAIN/auth/sso/github/callback

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://DOMAIN/auth/sso/google/callback

GOTENBERG_URL=http://172.29.0.13:3000
WEB_URL=https://DOMAIN

# Hanya traefik (.10) dan web (.11) di subnet compose prod 172.29.0.0/24 —
# bukan seluruh subnet. Kosong = XFF tidak pernah dipercaya.
TRUSTED_PROXY_CIDRS=172.29.0.10/32,172.29.0.11/32

# TMPDIR (spool rakda-view-* / rakda-rendition-* / rakda-wm-*) dan
# DISK_CACHE_DIR disetel di compose.prod.yaml berpasangan dengan bind
# mount-nya — `environment:` menang atas env_file, jadi nilai di sini tidak
# berpengaruh.

# Cache disk lokal terenkripsi (rendition, PNG halaman, artefak unduhan).
# Aktif hanya bila DISK_CACHE_DIR terisi (di compose); saat aktif KEY wajib:
#   openssl rand -base64 32
# Ganti kunci = seluruh cache dibuang saat boot (cache, bukan data). Anggaran
# per tier dan min-free adalah asumsi pembagian 80 GB; satuan k/m/g.
DISK_CACHE_KEY=
DISK_CACHE_RENDITION_BUDGET=20g
DISK_CACHE_PAGE_BUDGET=20g
DISK_CACHE_DOWNLOAD_BUDGET=5g
DISK_CACHE_MIN_FREE=5g
