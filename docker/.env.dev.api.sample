# cp .env.dev.api.sample .env.dev.api lalu isi. File nyata digitignore.
# Server dev memakai INSTANCE managed PG yang sama dengan prod, database
# terpisah rakda_dev — dan bucket S3 terpisah.

ADDR=:8080

# WAJIB direct connection atau session pooler — transaction pooler merusak
# prepared statement pgx (SQLSTATE 26000). Salin host/port/user PERSIS dari
# blok koneksi di panel provider (ekor username = tenant id, jangan dibuang).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=rakda_dev
DB_SSLMODE=require
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=10m

# Endpoint TANPA scheme (host[:port]). Bucket dev dibuat manual di console.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rakda-file-dev
MINIO_SSL_MODE=true

# goose (podman compose run --rm migrate up). Selaras blok DB_* di atas —
# dan dengan secret DEV_GOOSE_DBSTRING di GitHub.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://USER:PASSWORD@HOST:5432/rakda_dev?sslmode=require

OTP_SECRET=
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Registrasi OAuth terpisah untuk domain dev (redirect URL beda domain).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=https://DEV_DOMAIN/auth/sso/github/callback

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://DEV_DOMAIN/auth/sso/google/callback

GOTENBERG_URL=http://172.30.0.13:3000
WEB_URL=https://DEV_DOMAIN

# Hanya traefik (.10) dan web (.11) di subnet 172.30.0.0/24.
TRUSTED_PROXY_CIDRS=172.30.0.10/32,172.30.0.11/32
