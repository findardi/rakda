# cp .env.dev.api.sample .env.dev.api lalu isi. File nyata digitignore.
# Server dev memakai INSTANCE managed PG yang sama dengan prod, database
# terpisah rakda_dev — dan bucket S3 terpisah.

ADDR=:8080

# WAJIB direct connection atau session pooler — transaction pooler merusak
# prepared statement pgx (SQLSTATE 26000). Salin host/port/user PERSIS dari
# blok koneksi di panel provider (ekor username = tenant id, jangan dibuang).
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=rakda_dev
DB_SSLMODE=require
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=10m

# Endpoint TANPA scheme (host[:port]). Bucket dev dibuat manual di console.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rakda-file-dev
MINIO_SSL_MODE=true

# Enkripsi at-rest. API selalu MENCOBA menyalakan enkripsi bucket-default lalu
# MELAPORKAN statusnya di log boot. Flag ini menaikkannya jadi syarat: true =
# menolak boot bila bucket tidak terbukti terenkripsi. Biarkan false sampai
# dukungan SSE provider terverifikasi di bucket ini (aws s3api
# get-bucket-encryption) — cakupan S3 provider ini sudah terbukti parsial
# sekali, lihat U-53. Butuh MINIO_SSL_MODE=true.
MINIO_REQUIRE_ENCRYPTION=false

# goose (podman compose run --rm migrate up). Selaras blok DB_* di atas —
# dan dengan secret DEV_GOOSE_DBSTRING di GitHub.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://USER:PASSWORD@HOST:5432/rakda_dev?sslmode=require

OTP_SECRET=
JWT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Registrasi OAuth terpisah untuk domain dev (redirect URL beda domain).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=https://DEV_DOMAIN/auth/sso/github/callback

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=https://DEV_DOMAIN/auth/sso/google/callback

GOTENBERG_URL=http://172.30.0.13:3000
WEB_URL=https://DEV_DOMAIN

# Hanya traefik (.10) dan web (.11) di subnet 172.30.0.0/24.
TRUSTED_PROXY_CIDRS=172.30.0.10/32,172.30.0.11/32

# TMPDIR (spool rakda-view-* / rakda-rendition-* / rakda-wm-*) dan
# DISK_CACHE_DIR disetel di compose.dev-server.yaml berpasangan dengan bind
# mount-nya — `environment:` menang atas env_file, jadi nilai di sini tidak
# berpengaruh.

# Cache disk lokal terenkripsi (rendition, PNG halaman, artefak unduhan).
# Aktif hanya bila DISK_CACHE_DIR terisi (di compose); saat aktif KEY wajib:
#   openssl rand -base64 32
# Kunci dev BERBEDA dari prod. Ganti kunci = seluruh cache dibuang saat boot.
DISK_CACHE_KEY=
DISK_CACHE_RENDITION_BUDGET=20g
DISK_CACHE_PAGE_BUDGET=20g
DISK_CACHE_DOWNLOAD_BUDGET=5g
DISK_CACHE_MIN_FREE=5g

# Worker konversi rendition: LibreOffice di gotenberg serial, jadi WORKERS>1
# hanya memindahkan antrean; interval = jaring pengaman bila wake terlewat.
RENDITION_WORKERS=1
RENDITION_SWEEP_INTERVAL=30s
